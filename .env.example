VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: EAN barcode lookup-to-prefill. Leave both unset to disable the
# "Code-barre EAN" field entirely (the rest of the app is unaffected).
VITE_PUZZLE_LOOKUP_URL=https://your-puzzle-lookup-domain
VITE_PUZZLE_LOOKUP_API_KEY=same-shared-key-as-the-puzzle-lookup-service

# Optional: RevenueCat public SDK key (Android), used for the premium
# unlock purchase. Leave unset to disable the purchase button — the
# premium locks then just show their informational copy, no crash.
VITE_REVENUECAT_ANDROID_API_KEY=goog_your-revenuecat-public-android-key
